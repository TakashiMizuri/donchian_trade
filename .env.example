# === Lighter ===
# testnet | mainnet
LIGHTER_NETWORK=testnet
# API key private key (hex, with or without 0x). Indices 0-3 are reserved for the Lighter UI/app — use 4-254.
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=4
# Optional L1 address (used only as a sanity check / docs helper)
LIGHTER_L1_ADDRESS=

# === Strategy / instruments ===
# Candidate live: 5m brk+vol + tstop 20h (docs/DONCHIAN_LIVE_STARTPACK_5M_BRK_VOL_TSTOP20.md).
# BTC+ETH @ 1% each on one account is more aggressive than EW research sleeves.
SYMBOLS=BTC,ETH
# Shadow baseline = unfiltered. Twin (brk/vol) reuses DB book shadow_ls5; tstop usually off on twin.
SHADOW_BASELINE=true
DONCHIAN_SHADOW_BRK_VOL=true

# --- Donchian profile: 5m + brk0.5+vol_rank + tstop 20h ---
DONCHIAN_TAG=5m_N360_M180_ATR240_R1.0_brk0.5_vol0.64_tstop20h
DONCHIAN_TIMEFRAME=5m
DONCHIAN_BAR_SECONDS=300
DONCHIAN_CHANNEL_N=360
DONCHIAN_EXIT_M=180
DONCHIAN_ATR_PERIOD=240
DONCHIAN_ATR_METHOD=sma_tr
DONCHIAN_ATR_STOP_MULT=1.5
DONCHIAN_RISK_PCT=1.0
DONCHIAN_MAX_RISK_USD=625
DONCHIAN_MAX_RISK_ENABLED=true
DONCHIAN_FEE_RATE_PER_SIDE=0

# live: brk0.5+vol_rank | brk0.5 | vol_rank | baseline
DONCHIAN_LIVE_PROFILE=brk0.5+vol_rank
DONCHIAN_MIN_BREAKOUT_ATR=0.5
DONCHIAN_MAX_VOL_RANK=0.64
# 5m: ~20h / ~42d
DONCHIAN_VOL_RANK_BARS=240
DONCHIAN_VOL_RANK_LOOKBACK=12000

# Time-stop: 240 bars × 5m = 20h. Twin shadow keeps filters but tstop off for match book.
DONCHIAN_MAX_BARS_IN_TRADE=240
DONCHIAN_SHADOW_MAX_BARS_IN_TRADE=0

# Never point a new TF/profile at an old bot.db — archive it first.
CASH_FLOW_MIN_USD=5

# === Risk guards (operational, not research alpha) ===
MAX_NOTIONAL_USD=50000
DAILY_LOSS_LIMIT_USD=500
MAX_LEVERAGE=10
MARKET_SLIPPAGE=0.02
KILL_SWITCH=false

# === Storage / HTTP ===
SQLITE_PATH=/data/bot.db
LOG_DIR=/data/logs
HTTP_ADDR=:8080
DASHBOARD_PASSWORD=change-me
COOKIE_SECURE=false
WEB_PORT=80

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HEARTBEAT_MINUTES=60

# === Optional: skip sending orders (local tests only) ===
DRY_RUN=false
