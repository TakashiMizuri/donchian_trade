# === Lighter ===
# testnet | mainnet
LIGHTER_NETWORK=testnet
# API key private key (hex, with or without 0x). Indices 0-1 are reserved for the Lighter UI — use 2-254.
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=2
# Optional L1 address (used only as a sanity check / docs helper)
LIGHTER_L1_ADDRESS=

# === Strategy / instruments ===
# Lighter perp symbols, comma-separated. Resolved to market_id at startup.
SYMBOLS=BTC,ETH
# Shadow books from bar 0 (startpack §17). Live orders follow DONCHIAN_LIVE_PROFILE; both shadows are theoretical.
SHADOW_LS5=true
SHADOW_BASELINE=true

# --- Donchian profile (change TF/N/M here, then restart with a NEW sqlite) ---
# Default: calendar equivalent of 1h N=30 / M=15 / ATR(20) on 30m bars.
DONCHIAN_TAG=30m_N60_M30_ATR40_R1.0+ls5_cond_brk2.0
DONCHIAN_TIMEFRAME=30m
# Optional. Must match TF (1800 for 30m, 3600 for 1h, 900 for 15m, 300 for 5m).
# DONCHIAN_BAR_SECONDS=1800
DONCHIAN_CHANNEL_N=60
DONCHIAN_EXIT_M=30
DONCHIAN_ATR_PERIOD=40
DONCHIAN_ATR_METHOD=sma_tr
DONCHIAN_ATR_STOP_MULT=1.5
DONCHIAN_RISK_PCT=1.0
DONCHIAN_MAX_RISK_USD=1000
DONCHIAN_MAX_RISK_ENABLED=true
DONCHIAN_FEE_RATE_PER_SIDE=0
# live: ls5_cond_brk2.0 | baseline
DONCHIAN_LIVE_PROFILE=ls5_cond_brk2.0
DONCHIAN_LS5_LOSS_STREAK_N=5
# Pause is 24 hours; bars are derived from TIMEFRAME (30m → 48, 1h → 24).
DONCHIAN_LS5_PAUSE_HOURS=24
# Optional. If set, must equal PAUSE_HOURS / bar.
# DONCHIAN_LS5_PAUSE_BARS=48
DONCHIAN_LS5_RESUME_MIN_BREAKOUT_ATR=2.0
# Rollback to the old 1h freeze: TIMEFRAME=1h CHANNEL_N=30 EXIT_M=15 ATR_PERIOD=20 (pause becomes 24 bars).
# Never point a new TF at an old bot.db — archive it first.
# Shadow cash mirrors live deposits/withdrawals (residual of wallet vs trading).
# First observed live equity seeds all three books — no START_EQUITY needed.
# Ignore moves smaller than this (fees / mark dust).
CASH_FLOW_MIN_USD=5

# === Risk guards (operational, not research alpha) ===
MAX_NOTIONAL_USD=50000
DAILY_LOSS_LIMIT_USD=500
MAX_LEVERAGE=10
# Worst-acceptable price for market IOC, fraction (0.02 = 2%)
MARKET_SLIPPAGE=0.02
# Set true to flatten everything and refuse new entries.
KILL_SWITCH=false

# === Storage / HTTP ===
SQLITE_PATH=/data/bot.db
HTTP_ADDR=:8080
# Password for the dashboard. Required in production.
DASHBOARD_PASSWORD=change-me
# Cookie Secure flag. Set true behind HTTPS (Caddy).
COOKIE_SECURE=false
# Порт дашборда на VPS. 80 = http://IP/ с любого устройства (ufw allow 80).
# Если поднимете Caddy на 80/443, поставьте 127.0.0.1:8080
WEB_PORT=80

# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs that may talk to the bot.
TELEGRAM_CHAT_IDS=
# Heartbeat if nothing was sent for this many minutes (0 disables).
TELEGRAM_HEARTBEAT_MINUTES=60

# === Optional: skip sending orders (local tests only) ===
DRY_RUN=false
