# === Lighter ===
# testnet | mainnet
LIGHTER_NETWORK=testnet
# API key private key (hex, with or without 0x). Indices 0-3 are reserved for the Lighter UI/app — use 4-254.
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=4
# Optional L1 address (used only as a sanity check / docs helper)
LIGHTER_L1_ADDRESS=

# === Strategy / instruments ===
# Default live: BTC only (full 1% risk). ETH = separate account / split risk — do not dual full-1%.
SYMBOLS=BTC
# Shadow baseline = unfiltered. Twin (brk/vol) reuses DB book shadow_ls5 for Live↔shadow match.
SHADOW_BASELINE=true
DONCHIAN_SHADOW_BRK_VOL=true

# --- Donchian profile (change TF/N/M here, then restart with a NEW sqlite) ---
# Default: 15m calendar-eq of 1h N30 + brk0.5+vol_rank (docs/DONCHIAN_LIVE_STARTPACK_15M_BRK_VOL.md)
DONCHIAN_TAG=15m_N120_M60_ATR80_R1.0_brk0.5_vol0.64
DONCHIAN_TIMEFRAME=15m
# Optional. Must match TF (900 for 15m, 1800 for 30m, 3600 for 1h, 300 for 5m).
# DONCHIAN_BAR_SECONDS=900
DONCHIAN_CHANNEL_N=120
DONCHIAN_EXIT_M=60
DONCHIAN_ATR_PERIOD=80
DONCHIAN_ATR_METHOD=sma_tr
DONCHIAN_ATR_STOP_MULT=1.5
DONCHIAN_RISK_PCT=1.0
DONCHIAN_MAX_RISK_USD=625
DONCHIAN_MAX_RISK_ENABLED=true
DONCHIAN_FEE_RATE_PER_SIDE=0
# live: brk0.5+vol_rank | brk0.5 | vol_rank | baseline
DONCHIAN_LIVE_PROFILE=brk0.5+vol_rank
DONCHIAN_MIN_BREAKOUT_ATR=0.5
DONCHIAN_MAX_VOL_RANK=0.64
# Optional; defaults scale with TF (~20h / ~42d). 15m → 80 / 4032.
DONCHIAN_VOL_RANK_BARS=80
DONCHIAN_VOL_RANK_LOOKBACK=4000
# Never point a new TF/profile at an old bot.db — archive it first.
# Shadow cash mirrors live deposits/withdrawals (residual of wallet vs trading).
# First observed live equity seeds all three books — no START_EQUITY needed.
# Ignore moves smaller than this (fees / mark dust).
CASH_FLOW_MIN_USD=5

# === Risk guards (operational, not research alpha) ===
MAX_NOTIONAL_USD=50000
DAILY_LOSS_LIMIT_USD=500
MAX_LEVERAGE=10
# Worst-acceptable price for market IOC, fraction (0.02 = 2%)
MARKET_SLIPPAGE=0.02
# Set true to flatten everything and refuse new entries.
KILL_SWITCH=false

# === Storage / HTTP ===
SQLITE_PATH=/data/bot.db
# Detailed JSONL analysis logs (daily files bot-YYYYMMDD.jsonl). Docker volume mounts ./data → /data.
LOG_DIR=/data/logs
HTTP_ADDR=:8080
# Password for the dashboard. Required in production.
DASHBOARD_PASSWORD=change-me
# Cookie Secure flag. Set true behind HTTPS (Caddy).
COOKIE_SECURE=false
# Порт дашборда на VPS. 80 = http://IP/ с любого устройства (ufw allow 80).
# Если поднимете Caddy на 80/443, поставьте 127.0.0.1:8080
WEB_PORT=80

# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs that may talk to the bot.
TELEGRAM_CHAT_IDS=
# Heartbeat if nothing was sent for this many minutes (0 disables).
TELEGRAM_HEARTBEAT_MINUTES=60

# === Optional: skip sending orders (local tests only) ===
DRY_RUN=false
