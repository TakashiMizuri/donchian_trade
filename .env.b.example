# === bot_b — satellite 1m brk+vol + tstop 14h ===
# Contract: docs/DONCHIAN_LIVE_STARTPACK_1M_BRK_VOL_TSTOP14.md
# Role: write-off / experimental parallel to primary bot_a (5m). NOT a primary replacement.
#
# cp .env.b.example .env.b
# Fill LIGHTER_* for the satellite account / subaccount (different ACCOUNT_INDEX).
# Use the SAME DASHBOARD_PASSWORD as .env.a.

# === Instance (compose sets INSTANCE_ID=b; name via INSTANCE_B_NAME) ===
# INSTANCE_NAME=satellite_1m

# === Lighter (satellite account / subaccount) ===
LIGHTER_NETWORK=mainnet
LIGHTER_API_PRIVATE_KEY=
# Subaccount: different ACCOUNT_INDEX on same L1; API key created while that account is active.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_L1_ADDRESS=

# === Strategy / instruments ===
# BTC only at start; ETH is a separate decision after slip stabilizes.
SYMBOLS=BTC
SHADOW_BASELINE=true
DONCHIAN_SHADOW_BRK_VOL=true

# --- Donchian profile: 1m + brk0.5+vol_rank + tstop 14h (satellite) ---
DONCHIAN_TAG=1m_N1800_M900_ATR1200_R1.0_brk0.5_vol0.64_tstop14h_satellite
DONCHIAN_TIMEFRAME=1m
DONCHIAN_BAR_SECONDS=60
DONCHIAN_CHANNEL_N=1800
DONCHIAN_EXIT_M=900
DONCHIAN_ATR_PERIOD=1200
DONCHIAN_ATR_METHOD=sma_tr
DONCHIAN_ATR_STOP_MULT=1.5
DONCHIAN_RISK_PCT=1.0
DONCHIAN_MAX_RISK_USD=1000
DONCHIAN_MAX_RISK_ENABLED=true
DONCHIAN_FEE_RATE_PER_SIDE=0

DONCHIAN_LIVE_PROFILE=brk0.5+vol_rank
DONCHIAN_MIN_BREAKOUT_ATR=0.5
DONCHIAN_MAX_VOL_RANK=0.64
# 1m: ~20h / ~42d
DONCHIAN_VOL_RANK_BARS=1200
DONCHIAN_VOL_RANK_LOOKBACK=60000

# Time-stop: 840 bars × 1m = 14h. Twin shadow keeps filters, tstop off.
DONCHIAN_MAX_BARS_IN_TRADE=840
DONCHIAN_SHADOW_MAX_BARS_IN_TRADE=0

# Soft alternate (less DD): DONCHIAN_RISK_PCT=0.5 and a new run_id / fresh data/b.

CASH_FLOW_MIN_USD=5

# === Risk guards (ops — size satellite ≪ primary) ===
MAX_NOTIONAL_USD=20000
DAILY_LOSS_LIMIT_USD=200
MAX_LEVERAGE=25
MARKET_SLIPPAGE=0.02
KILL_SWITCH=false

# === Storage / HTTP ===
SQLITE_PATH=/data/bot.db
LOG_DIR=/data/logs
HTTP_ADDR=:8080
DASHBOARD_PASSWORD=change-me
COOKIE_SECURE=false
WEB_PORT=80

# === Telegram (prefer separate token or chat for satellite alerts) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HEARTBEAT_MINUTES=60

DRY_RUN=false
